diff --git a/source/fitz/load-webp.c b/source/fitz/load-webp.c
new file mode 100644
index 000000000..e7dab4f4e
--- /dev/null
+++ b/source/fitz/load-webp.c
@@ -0,0 +1,89 @@
+// Copyright (C) 2004-2025 Artifex Software, Inc.
+//
+// This file is part of MuPDF, modified to add WebP image support.
+
+#include "mupdf/fitz.h"
+
+#include "image-imp.h"
+
+#include <webp/decode.h>
+
+static WebPBitstreamFeatures
+webp_read_features(fz_context *ctx, const unsigned char *data, size_t size)
+{
+	WebPBitstreamFeatures features;
+	VP8StatusCode status = WebPGetFeatures(data, size, &features);
+
+	if (status != VP8_STATUS_OK || features.width <= 0 || features.height <= 0)
+		fz_throw(ctx, FZ_ERROR_FORMAT, "cannot read WebP image header");
+
+	return features;
+}
+
+void
+fz_load_webp_info(fz_context *ctx, const unsigned char *data, size_t size,
+	int *w, int *h, int *xres, int *yres, fz_colorspace **cspace)
+{
+	WebPBitstreamFeatures features = webp_read_features(ctx, data, size);
+
+	*w = features.width;
+	*h = features.height;
+	*xres = 96;
+	*yres = 96;
+	*cspace = fz_keep_colorspace(ctx, fz_device_rgb(ctx));
+}
+
+int
+fz_webp_is_lossy(fz_context *ctx, const unsigned char *data, size_t size)
+{
+	return webp_read_features(ctx, data, size).format == 1;
+}
+
+fz_pixmap *
+fz_load_webp(fz_context *ctx, const unsigned char *data, size_t size)
+{
+	WebPBitstreamFeatures features = webp_read_features(ctx, data, size);
+	fz_pixmap *pixmap = NULL;
+	int x, y;
+
+	fz_var(pixmap);
+
+	fz_try(ctx)
+	{
+		pixmap = fz_new_pixmap(ctx, fz_device_rgb(ctx), features.width, features.height, NULL, features.has_alpha);
+		if (features.has_alpha)
+		{
+			if (!WebPDecodeRGBAInto(data, size,
+				pixmap->samples, (size_t)pixmap->stride * pixmap->h, pixmap->stride))
+				fz_throw(ctx, FZ_ERROR_FORMAT, "cannot decode WebP image");
+
+			/* libwebp returns straight alpha; MuPDF pixmaps use premultiplied alpha. */
+			for (y = 0; y < pixmap->h; ++y)
+			{
+				unsigned char *sample = pixmap->samples + (size_t)y * pixmap->stride;
+				for (x = 0; x < pixmap->w; ++x)
+				{
+					unsigned int alpha = sample[x * 4 + 3];
+					sample[x * 4 + 0] = (unsigned char)(sample[x * 4 + 0] * alpha / 255);
+					sample[x * 4 + 1] = (unsigned char)(sample[x * 4 + 1] * alpha / 255);
+					sample[x * 4 + 2] = (unsigned char)(sample[x * 4 + 2] * alpha / 255);
+				}
+			}
+		}
+		else
+		{
+			if (!WebPDecodeRGBInto(data, size,
+				pixmap->samples, (size_t)pixmap->stride * pixmap->h, pixmap->stride))
+				fz_throw(ctx, FZ_ERROR_FORMAT, "cannot decode WebP image");
+		}
+
+		fz_set_pixmap_resolution(ctx, pixmap, 96, 96);
+	}
+	fz_catch(ctx)
+	{
+		fz_drop_pixmap(ctx, pixmap);
+		fz_rethrow(ctx);
+	}
+
+	return pixmap;
+}
