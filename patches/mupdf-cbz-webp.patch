+static fz_image *
+cbz_load_webp_image(fz_context *ctx, fz_buffer *buf)
+{
+	size_t len;
+	unsigned char *data;
+	int w = 0, h = 0;
+	uint8_t *rgb;
+	fz_pixmap *pixmap = NULL;
+	fz_image *image = NULL;
+	len = fz_buffer_storage(ctx, buf, &data);
+	rgb = WebPDecodeRGB(data, len, &w, &h);
+	if (!rgb || w <= 0 || h <= 0)
+		fz_throw(ctx, FZ_ERROR_FORMAT, "cannot decode WebP image");
+	fz_var(pixmap);
+	fz_try(ctx)
+	{
+		int y;
+		pixmap = fz_new_pixmap(ctx, fz_device_rgb(ctx), w, h, NULL, 0);
+		for (y = 0; y < h; y++)
+			memcpy(pixmap->samples + y * pixmap->stride, rgb + y * w * 3, w * 3);
+		image = fz_new_image_from_pixmap(ctx, pixmap, NULL);
+	}
+	fz_always(ctx)
+	{
+		WebPFree(rgb);
+		fz_drop_pixmap(ctx, pixmap);
+	}
+	fz_catch(ctx)
+		fz_rethrow(ctx);
+	return image;
+}
