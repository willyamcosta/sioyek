+static fz_image *
+cbz_load_webp_image(fz_context *ctx, fz_buffer *buf)
+{
+	size_t len;
+	unsigned char *data;
+	int w = 0, h = 0;
+	uint8_t *rgba;
+	fz_pixmap *pixmap = NULL;
+	fz_image *image = NULL;
+	len = fz_buffer_storage(ctx, buf, &data);
+	rgba = WebPDecodeRGBA(data, len, &w, &h);
+	if (!rgba || w <= 0 || h <= 0)
+		fz_throw(ctx, FZ_ERROR_FORMAT, "cannot decode WebP image");
+	fz_var(pixmap);
+	fz_try(ctx)
+	{
+		int x, y;
+		/* WebP returns straight alpha; mupdf pixmaps are premultiplied. */
+		pixmap = fz_new_pixmap(ctx, fz_device_rgb(ctx), w, h, NULL, 1);
+		for (y = 0; y < h; y++)
+		{
+			unsigned char *src = rgba + (size_t)y * w * 4;
+			unsigned char *dst = pixmap->samples + (size_t)y * pixmap->stride;
+			for (x = 0; x < w; x++)
+			{
+				unsigned int a = src[x * 4 + 3];
+				dst[x * 4 + 0] = (unsigned char)(src[x * 4 + 0] * a / 255);
+				dst[x * 4 + 1] = (unsigned char)(src[x * 4 + 1] * a / 255);
+				dst[x * 4 + 2] = (unsigned char)(src[x * 4 + 2] * a / 255);
+				dst[x * 4 + 3] = (unsigned char)a;
+			}
+		}
+		image = fz_new_image_from_pixmap(ctx, pixmap, NULL);
+	}
+	fz_always(ctx)
+	{
+		WebPFree(rgba);
+		fz_drop_pixmap(ctx, pixmap);
+	}
+	fz_catch(ctx)
+		fz_rethrow(ctx);
+	return image;
+}
